APP_ENV=development
APP_PORT=8080
APP_CORS_ORIGIN=http://localhost:5173,https://elyusr.org
JWT_SECRET=change-me-to-a-long-random-string

# اختر mysql أو mongo
DB_DRIVER=mysql

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=alyusr
MYSQL_USER=root
MYSQL_PASSWORD=

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=alyusr

# Storage
STORAGE_DRIVER=local
STORAGE_PATH=./storage

# ─── Kashier Payment Gateway ────────────────────────────────────
# احصل على هذه القيم من لوحة تحكم كاشير: https://merchant.kashier.io
KASHIER_MERCHANT_ID=your-kashier-merchant-id
KASHIER_SECRET_KEY=your-kashier-secret-key
KASHIER_MODE=test
# عند الإنتاج: KASHIER_MODE=live  + مفاتيح الإنتاج من لوحة التحكم

# Webhook secret — يُنشئه كاشير عند ضبط webhook في لوحة التحكم
# KASHIER_WEBHOOK_SECRET=