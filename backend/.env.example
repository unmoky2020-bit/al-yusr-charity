APP_ENV=development
APP_PORT=8080
APP_CORS_ORIGIN=http://localhost:5173,https://elyusr.org
JWT_SECRET=change-me-to-a-long-random-string

# اختر mysql أو mongo
DB_DRIVER=mysql

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=alyusr
MYSQL_USER=root
MYSQL_PASSWORD=

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=alyusr

# Storage
STORAGE_DRIVER=local
STORAGE_PATH=./storage