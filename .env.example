VITE_LARAVEL_READONLY_API_TOKEN=
# Backend program id for general (untargeted) donations: create "تبرع عام" in admin and put its id here
VITE_GENERAL_PROGRAM_ID=
# Where the PUBLIC site reads its static content (programs, donation entities, services, blog, gallery, projects):
#   static (default) = the TypeScript files in src/data, exactly as today
#   api / auto       = the Laravel API, falling back to the static copy for any item the API does not have
VITE_CONTENT_SOURCE=static
