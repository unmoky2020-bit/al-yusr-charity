# ==============================================================================
# Hostinger (LiteSpeed / Apache) Configuration for Al-Yusr (elyusr.org)
# ==============================================================================

# 1. SECURITY HEADERS (Fixes SEMrush "No HSTS support" and hardens security)
<IfModule mod_headers.c>
    # Strict-Transport-Security (HSTS) — 1 year + subdomains + preload
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    
    # Prevent MIME sniffing
    Header always set X-Content-Type-Options "nosniff"
    # Don't advertise the PHP version (was "X-Powered-By: PHP/8.3.x")
    Header always unset X-Powered-By
    Header unset X-Powered-By
    
    # Clickjacking protection
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Referrer policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Browser features the site never needs
    Header always set Permissions-Policy 'camera=(), microphone=(), geolocation=(), payment=(self "https://payments.kashier.io" "https://checkout.kashier.io")'

    # Content Security Policy in REPORT-ONLY mode first: watch the browser console for a week,
    # then change the header name to Content-Security-Policy. 'unsafe-inline' for scripts is needed
    # only by the inline Google Analytics bootstrap in index.html; move it to a file to drop it.
    Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://connect.facebook.net https://www.clarity.ms https://scripts.clarity.ms; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://api.elyusr.org https://elyusr-api.pyramedx.com https://api.kashier.io https://test-api.kashier.io https://payments.kashier.io https://checkout.kashier.io https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com https://stats.g.doubleclick.net https://www.googletagmanager.com https://www.facebook.com https://*.clarity.ms https://api.gold-api.com https://open.er-api.com; frame-src 'self' https://www.googletagmanager.com https://payments.kashier.io https://checkout.kashier.io https://test-checkout.kashier.io https://accept.paymob.com https://www.google.com https://maps.google.com https://www.youtube.com https://www.facebook.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://payments.kashier.io https://checkout.kashier.io https://accept.paymob.com https://www.facebook.com; frame-ancestors 'self'"
</IfModule>

# 2. REWRITE RULES (HTTPS, Non-WWW 301 Redirect, & SPA Routing)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # A. Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # B. Force non-www (Redirect www.elyusr.org -> https://elyusr.org)
    # Fixes SEMrush duplicate page crawl and hreflang conflict on www
    RewriteCond %{HTTP_HOST} ^www\.elyusr\.org$ [NC]
    RewriteRule ^(.*)$ https://elyusr.org/$1 [L,R=301]

    # C0. Live sitemap: the built one + whatever the dashboard published since (cached 30 min).
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # C. Allow direct access to existing files and directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # D. React SPA fallback through seo.php: same index.html, plus the page's own title, description,
    #    image and summary for social previews and crawlers that do not run JavaScript.
    #    (seo.php serves the untouched index.html if anything goes wrong.)
    RewriteRule ^ seo.php [L]
</IfModule>

# 3. CACHING & PERFORMANCE (LiteSpeed & Apache Expires)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML: never cache (always check for app updates)
    ExpiresByType text/html "access plus 0 seconds"

    # Hashed JS & CSS
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # Images & Media
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/avif "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"

    # Fonts
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"

    # XML Sitemaps
    ExpiresByType application/xml "access plus 1 hour"
    ExpiresByType text/xml "access plus 1 hour"
</IfModule>

# 4. GZIP / DEFLATE COMPRESSION
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
